<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 스크롤 가능한 콘텐츠 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/dividerNavFeed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 앱바: 뒤로/타이틀/알림 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

<!--                상단에 뒤로가기 버튼 -> 필요 없어서 삭제-->
<!--                <ImageButton-->
<!--                    android:id="@+id/btnBack"-->
<!--                    android:layout_width="24dp"-->
<!--                    android:layout_height="24dp"-->
<!--                    android:src="@drawable/ic_arrow_back"-->
<!--                    android:layout_marginTop="20dp"-->
<!--                    android:background="?attr/selectableItemBackgroundBorderless"-->
<!--                    android:contentDescription="뒤로가기" />-->

                <TextView
                    android:id="@+id/tvHomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="띵동 시흥"
                    android:textColor="#131316"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnHomeNotify"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_bell"
                    android:layout_marginEnd="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="알림" />
            </RelativeLayout>

            <!-- 실제 달력 CalendarView 추가 -->
            <CalendarView
                android:id="@+id/calendarViewHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- 오늘의 할일 -->
            <TextView
                android:id="@+id/tvTasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="30dp"
                android:paddingRight="8dp"
                android:text="오늘의 할일"
                android:textColor="#121316"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 동적 오늘의 할일 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTasksHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <!-- 진행중인 사진 콘테스트 -->
            <TextView
                android:id="@+id/tvContestHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="30dp"
                android:paddingTop="24dp"
                android:paddingBottom="5dp"
                android:text="진행중인 사진 콘테스트"
                android:textColor="#131316"
                android:textSize="18sp"
                android:textStyle="bold" />
            <HorizontalScrollView
                android:id="@+id/scrollContest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="30dp"
                android:paddingTop="8dp"
                android:paddingEnd="30dp"
                android:scrollbars="none"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!-- 카드 1 -->
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:background="@android:color/transparent">
                            <ImageView
                                android:id="@+id/contest1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/baegot_event"
                                android:contentDescription="배곧 생명 공원을 찾아랏 행사"
                                android:scaleType="centerCrop" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="배곧 생명 공원을 찾아랏 행사"
                            android:textColor="#131316"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <!-- 카드 2 -->
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:background="@android:color/transparent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/oido_event"
                                android:contentDescription="오이도에서 해로와 토로 찾기"
                                android:scaleType="centerCrop" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="오이도에서 해로와 토로 찾기"
                            android:textColor="#131316"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <!-- 카드 3 -->
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:background="@android:color/transparent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/tino_event"
                                android:contentDescription="티노랜드에 오신 걸 환영합니다"
                                android:scaleType="centerCrop" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="티노랜드에 오신 걸 환영합니다"
                            android:textColor="#131316"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Nav Divider -->
    <View
        android:id="@+id/dividerNavFeed"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        app:layout_constraintBottom_toTopOf="@+id/llBottomNavFeed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/llBottomNavFeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home 탭 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/home1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_fill" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#121317"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 			Calendar 탭 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/calendar1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textColor="#6D6F7E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Feed 탭 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/feed1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_feed" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feed"
                android:textColor="#6D6F7E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- My Page 탭 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/mypage1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_user" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Page"
                android:textColor="#6D6F7E"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
