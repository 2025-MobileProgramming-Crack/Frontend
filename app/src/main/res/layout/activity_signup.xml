<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Form content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnSignUp2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#131316"
                    android:contentDescription="뒤로가기" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="회원가입"
                    android:textColor="#131316"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Email Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="이메일을 입력하세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <!-- Password Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="비밀번호"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="비밀번호를 입력해주세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp" />

            <!-- Confirm Password Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="비밀번호 확인"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etPasswordConfirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="비밀번호를 한 번 더 입력해주세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp" />

            <!-- Nickname Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이름"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="이름을 입력해주세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp" />

            <!-- Region Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="거주지역"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etRegion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="지역을 입력해주세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- phonenum Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="전화번호"
                android:textColor="#131316"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="전화번호를 입력해주세요"
                android:textColorHint="#6D6F7E"
                android:textColor="#131316"
                android:background="@drawable/bg_rounded_gray"
                android:padding="16dp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Sign Up Button -->
    <Button
        android:id="@+id/btnSignUp2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="회원가입"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2C2F8C"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

